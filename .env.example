# Required: Discord application and target guild.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
CLIENT_ID=YOUR_DISCORD_APPLICATION_ID
GUILD_ID=YOUR_DISCORD_SERVER_ID

# Optional runtime flag.
NODE_ENV=production

# Optional: Annict API token for anime metadata search.
# Used read-only by Otaku Assistant.
ANNICT_ACCESS_TOKEN=YOUR_ANNICT_ACCESS_TOKEN

# Optional: Odesli API key for richer music link previews.
ODESLI_API_KEY=

# Optional: local Ollama endpoint/model for LLM reply features.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
